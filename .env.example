# Copie para `.env` e preencha.

# Sessão — obrigatório, mínimo 32 caracteres (ex.: openssl rand -base64 32).
NUXT_SESSION_PASSWORD=sua-senha-de-sessao-com-32-caracteres-ou-mais

# Banco de dados (libSQL / Turso).
# Dev: arquivo local. Produção: libsql://<seu-db>.turso.io
TURSO_DATABASE_URL=file:.data/memora.db
TURSO_AUTH_TOKEN=

# Armazenamento de imagens: local | r2
NUXT_STORAGE_DRIVER=local
NUXT_STORAGE_LOCAL_DIR=.data/uploads

# Cloudflare R2 (apenas quando NUXT_STORAGE_DRIVER=r2)
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=memora
NUXT_R2_ENDPOINT=

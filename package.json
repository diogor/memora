{
  "name": "memora",
  "version": "0.1.0",
  "private": true,
  "description": "Memora — plataforma privada de memórias: a história por trás de cada foto.",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-security": "^2.6.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
